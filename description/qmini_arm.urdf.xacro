    <xacro:box_collision
      xyz="0.028650004 -0.117945574 0.104848938"
      rpy="0 -0.726682211 -1.570796327" size="0.3003 0.015 0.075"/>
    <xacro:motor_collision
      xyz="0.013000008 -0.224214968 0.199318367"
