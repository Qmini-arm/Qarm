      rpy="-3.141592654 -0.726682211 -1.570796327" size="0.0894 0.035 0.059"/>
  </link>

  <link name="tool0"/>

  <xacro:arm_joint
    name="joint_1" parent="base_link" child="link_1"
    xyz="0 0 0" rpy="0 0 0"
    limit="${joint_1_limit}" soft_limit="${joint_1_soft_limit}"/>
  <xacro:arm_joint
    name="joint_2" parent="link_1" child="link_2"
    xyz="0.082449884 0.000464880 0.000523357"
    rpy="0.7259 0.844114116 -1.570796327"
    limit="${joint_2_limit}" soft_limit="${joint_2_soft_limit}"/>
  <xacro:arm_joint
