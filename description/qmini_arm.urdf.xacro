<?xml version="1.0"?>
<robot name="qmini_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Generated from Qmini-arm-2+1+3.SLDASM.
    Joint zero matches the saved CAD pose. All meshes and dimensions use SI units.
  -->

  <!--
    Collision-screened independent limits.  The 2nd and 4th joints are the
    closest to the fixed base and to the other long arm, respectively.
    Values are radians; soft limits leave a small stopping margin.
  -->
  <xacro:property name="joint_1_limit" value="3.141592654"/>
  <xacro:property name="joint_2_limit" value="1.57"/>
  <xacro:property name="joint_3_limit" value="2.62"/>
  <xacro:property name="joint_4_limit" value="2.094395102"/>
  <xacro:property name="joint_5_limit" value="2.094395102"/>
  <xacro:property name="joint_6_limit" value="1.57"/>
  <xacro:property name="joint_1_soft_limit" value="2.967059728"/>
  <xacro:property name="joint_2_soft_limit" value="1.5"/>
  <xacro:property name="joint_3_soft_limit" value="2.007128640"/>
  <xacro:property name="joint_4_soft_limit" value="2.0"/>
  <xacro:property name="joint_5_soft_limit" value="2.007128640"/>
  <xacro:property name="joint_6_soft_limit" value="1.5"/>
  <xacro:property name="effort_limit" value="23.7"/>
  <xacro:property name="velocity_limit" value="3.0"/>

  <material name="motor_gray">
    <color rgba="0.27 0.29 0.32 1.0"/>
  </material>
  <material name="link_silver">
    <color rgba="0.72 0.74 0.77 1.0"/>
  </material>
  <material name="tool_gray">
    <color rgba="0.40 0.43 0.47 1.0"/>
  </material>

  <xacro:macro name="inertial_block" params="mass xyz ixx ixy ixz iyy iyz izz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
        iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_visual" params="file xyz rpy material">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <mesh filename="meshes/visual/${file}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="motor_collision" params="xyz rpy">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <cylinder radius="0.04825" length="0.0423"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="box_collision" params="xyz rpy size">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <box size="${size}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="arm_joint" params="name parent child xyz rpy limit soft_limit">
    <joint name="${name}" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="${-limit}" upper="${limit}"
        effort="${effort_limit}" velocity="${velocity_limit}"/>
      <dynamics damping="0.08" friction="0.0"/>
      <safety_controller
        soft_lower_limit="${-soft_limit}"
        soft_upper_limit="${soft_limit}"
        k_position="20.0" k_velocity="2.0"/>
    </joint>
  </xacro:macro>

  <!-- Keep the CAD-derived chain untouched and correct its global yaw here. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <origin xyz="0 0 0" rpy="0.74 -1.57 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- Fixed GO-M8010-6 motor housing plus the new paired base plate. -->
  <link name="base_link">
    <xacro:inertial_block
      mass="0.594063035" xyz="-0.001443936 0.000095279 0.000025880"
      ixx="0.000935107" ixy="-0.000000883" ixz="-0.000000309"
      iyy="0.000550380" iyz="-0.000090250" izz="0.000529948"/>
    <xacro:mesh_visual
      file="motor.stl" xyz="0 0 0" rpy="0 0 0" material="motor_gray"/>
    <xacro:mesh_visual
      file="base_pair.stl"
      xyz="-0.013149996 -0.040727332 -0.045814406"
      rpy="1.570796327 -0.726688605 -1.570796327" material="link_silver"/>
    <xacro:motor_collision xyz="0 0 0" rpy="0 1.570796327 0"/>
    <collision>
      <origin xyz="-0.018149996 0.000000291 -0.000000098" rpy="0 -0.726688605 -1.570796327"/>
      <geometry>
        <box size="0.11 0.01 0.15888"/>
      </geometry>
    </collision>
  </link>

  <!-- Output of motor 1: first orthogonal bracket and motor 2 housing. -->
  <link name="link_1">
    <xacro:inertial_block
      mass="0.567450382" xyz="0.076902896 -0.000540190 -0.000692581"
      ixx="0.000373485" ixy="0.000001852" ixz="0.000002991"
      iyy="0.000594890" iyz="0.000130888" izz="0.000625051"/>
    <xacro:mesh_visual
      file="joint_bracket.stl"
      xyz="0.021150004 0.000000013 -0.000000002"
      rpy="0 -0.726682211 -1.570796327" material="link_silver"/>
    <xacro:mesh_visual
      file="motor.stl"
      xyz="0.082449884 0.000464880 0.000523357"
      rpy="-0.844107722 0.844114116 -1.570796327" material="motor_gray"/>
    <xacro:box_collision
      xyz="0.041150004 0.000000013 -0.000000002"
      rpy="0 -0.726682211 -1.570796327" size="0.09 0.04 0.043"/>
    <xacro:motor_collision
      xyz="0.082449884 0.000464880 0.000523357"
      rpy="-2.555167956 0.457182902 2.555159402"/>
  </link>

  <!-- Output of motor 2: first long arm and motor 3 housing. -->
  <link name="link_2">
    <xacro:inertial_block
      mass="0.676212997" xyz="0.016355333 0.193045983 -0.171512178"
      ixx="0.005975646" ixy="0.000310486" ixz="-0.000274800"
      iyy="0.002778247" iyz="0.002539658" izz="0.003380604"/>
    <xacro:mesh_visual
      file="arm_link.stl"
      xyz="0.026150004 0.224214862 -0.199318093"
      rpy="3.141592654 0.726682211 1.570796327" material="link_silver"/>
    <xacro:mesh_visual
      file="motor.stl"
      xyz="0.013000008 0.224214994 -0.199318371"
      rpy="1.453370820 0 -3.141592654" material="motor_gray"/>
    <xacro:box_collision
      xyz="0.028650004 0.117945600 -0.104848942"
      rpy="3.141592654 0.726682211 1.570796327" size="0.3003 0.015 0.075"/>
    <xacro:motor_collision
      xyz="0.013000008 0.224214994 -0.199318371"
      rpy="1.570796327 0.117425510 -1.570796327"/>
  </link>

  <!-- Output of motor 3: second long arm and motor 4 housing. -->
  <link name="link_3">
    <xacro:inertial_block
      mass="0.676213000" xyz="0.016353625 -0.193059219 0.171524730"
      ixx="0.005963547500" ixy="-0.000294104322" ixz="0.000262012657"
      iyy="0.002770304330" iyz="0.002545239940" izz="0.003376592910"/>
    <xacro:mesh_visual
      file="arm_link.stl"
