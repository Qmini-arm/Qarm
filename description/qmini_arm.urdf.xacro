  </link>

  <!-- Output of motor 4: third orthogonal bracket and motor 6 housing. -->
  <link name="link_4">
    <xacro:inertial_block
      mass="0.567450400" xyz="0.076904739 -0.000544010 -0.000695119"
      ixx="0.000383931992" ixy="0.000001966003" ixz="0.000001138033"
      iyy="0.000587346863" iyz="0.000135972895" izz="0.000620142776"/>
    <xacro:mesh_visual
      file="joint_bracket.stl"
      xyz="0.021150004 0.000000013 -0.000000002"
      rpy="0 -0.726682211 -1.570796327" material="link_silver"/>
    <xacro:mesh_visual
      file="motor.stl"
