<?xml version="1.0"?>
<robot name="qmini_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Generated from Qmini-arm.SLDASM.
    Joint zero matches the saved CAD pose. All meshes and dimensions use SI units.
  -->

  <xacro:property name="joint_limit" value="2.617993878"/>
  <xacro:property name="soft_joint_limit" value="2.530727415"/>
  <xacro:property name="effort_limit" value="23.7"/>
  <xacro:property name="velocity_limit" value="3.0"/>

  <material name="motor_gray">
    <color rgba="0.27 0.29 0.32 1.0"/>
  </material>
  <material name="link_silver">
    <color rgba="0.72 0.74 0.77 1.0"/>
  </material>
  <material name="tool_gray">
    <color rgba="0.40 0.43 0.47 1.0"/>
  </material>

  <xacro:macro name="inertial_block" params="mass xyz ixx ixy ixz iyy iyz izz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
        iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_visual" params="file xyz rpy material">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <mesh filename="package://qmini_arm_description/meshes/visual/${file}"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="motor_collision" params="xyz rpy">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <cylinder radius="0.04825" length="0.0423"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="box_collision" params="xyz rpy size">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <box size="${size}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="arm_joint" params="name parent child xyz rpy">
    <joint name="${name}" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="${-joint_limit}" upper="${joint_limit}"
        effort="${effort_limit}" velocity="${velocity_limit}"/>
      <dynamics damping="0.08" friction="0.0"/>
      <safety_controller
        soft_lower_limit="${-soft_joint_limit}"
        soft_upper_limit="${soft_joint_limit}"
        k_position="20.0" k_velocity="2.0"/>
    </joint>
  </xacro:macro>

  <!-- Fixed GO-M8010-6 motor housing. -->
  <link name="base_link">
    <xacro:inertial_block
      mass="0.5" xyz="0.001694875 0.000113148 0.000030767"
      ixx="0.000552544" ixy="-0.000000706" ixz="-0.000000261"
      iyy="0.000317218" iyz="-0.000005587" izz="0.000316759"/>
    <xacro:mesh_visual
      file="motor.stl" xyz="0 0 0" rpy="0 0 0" material="motor_gray"/>
    <xacro:motor_collision xyz="0 0 0" rpy="0 1.570796327 0"/>
  </link>

  <!-- Output of motor 1: first orthogonal bracket and motor 2 housing. -->
  <link name="link_1">
    <xacro:inertial_block
      mass="0.585848904" xyz="0.075587838 0.000106623 0.000545006"
      ixx="0.000390445" ixy="-0.000002165" ixz="-0.000003570"
      iyy="0.000629433" iyz="0.000134515" izz="0.000673929"/>
