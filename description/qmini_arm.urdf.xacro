  <!-- Output of motor 5: end-effector mounting bracket. -->
  <link name="link_6">
    <xacro:inertial_block
      mass="0.016653600" xyz="0.021295905 -0.013071630 0.011629218"
      ixx="0.000014346087" ixy="-0.000001170045" ixz="0.000001043159"
      iyy="0.000007453285" iyz="0.000004348922" izz="0.000008467991"/>
    <xacro:mesh_visual
